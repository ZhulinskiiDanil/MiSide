{
	"geode": "5.10.1",
	"gd": {
		"win": "2.2081"
	},
	"id": "zhulis.miside-menu",
	"name": "MiSide Menu",
	"version": "v0.1.0",
	"developer": "Zhulis",
	"description": "The main menu in the style of MiSide: a scene in the background, a column of text items on the left, soft transitions",
	"tags": [
		"interface",
		"customization"
	],
	"settings": {
		"vanilla-menu": {
			"name": "Vanilla menu",
			"description": "The main menu exactly as it is without the mod. Applies the next time the main menu opens",
			"type": "bool",
			"default": false
		},
		"parallax-strength": {
			"name": "Parallax strength",
			"description": "How far the background layers follow the mouse. 0 keeps them still",
			"type": "float",
			"default": 1.0,
			"min": 0,
			"max": 2,
			"control": {
				"slider": true,
				"slider-step": 0.1
			}
		},
		"menu-language": {
			"name": "Menu language",
			"description": "The language of the menu items: RU (Russian) or EN (English)",
			"type": "string",
			"default": "RU",
			"one-of": [
				"RU",
				"EN"
			]
		},
		"show-title": {
			"name": "Logo",
			"description": "The logo and \"Main menu\" above the menu items",
			"type": "bool",
			"default": true
		}
	},
	"resources": {
		"sprites": [
			"resources/background/*.png",
			"resources/placeholders/row-plate.png",
			"resources/placeholders/glow-soft.png",
			"resources/placeholders/item-accent.png",
			"resources/placeholders/tray-panel.png",
			"resources/placeholders/tray-slot.png",
			"resources/placeholders/avatar-circle.png",
			"resources/placeholders/pattern-tile.png",
			"resources/placeholders/vignette-soft.png"
		],
		"files": [
			"resources/sounds/hover.ogg",
			"resources/sounds/click.ogg",
			"resources/mita/mita_atlas_*.png",
			"resources/mita/mita-manifest.json",
			"resources/mita/MITA_ATTRIBUTION.txt",
			"resources/mita/mita-source-metadata.json"
		],
		"fonts": {
			"miside-font": {
				"path": "resources/fonts/MPLUSRounded1c-Bold.ttf",
				"size": 64,
				"charset": "32-126,1025,1040-1103,1105,8211,8212,8226,8230"
			},
			"miside-title": {
				"path": "resources/fonts/MPLUSRounded1c-ExtraBold.ttf",
				"size": 96,
				"charset": "32-126,1025,1040-1103,1105,8211,8212,8226,8230"
			}
		}
	}
}
